# Server
PORT=3000
# "development" -> verbose errors, relaxed cookies (local HTTP).
# ANY other value (including the conventional "production") -> safe errors +
# Secure/SameSite=None cookies. Security behaviour fails secure; see utils/env.util.js.
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/casaclean
# Optional: DNS resolvers for the mongodb+srv SRV lookup. Defaults to Google
# public DNS (8.8.8.8,8.8.4.4) — some ISP resolvers fail SRV lookups. Set it
# EMPTY (DNS_SERVERS=) to keep the system resolver (private/internal DNS).
#DNS_SERVERS=8.8.8.8,8.8.4.4

# Auth / JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES=7         # cookie lifetime in days

# URLs
CLIENT_URL=http://localhost:5173     # frontend, used for post-verification redirects
SERVER_URL=http://localhost:3000     # this API's public base URL, used to build verification links
# Optional: extra origins the API accepts CORS requests from, comma-separated
# (e.g. the www. variant of CLIENT_URL). CLIENT_URL stays the canonical origin
# used for redirects and emailed links.
#EXTRA_CORS_ORIGINS=https://www.example.com

# Optional: customer self-cancellations get an automatic FULL refund only when
# made at least this many hours before the appointment (default 24 — one day).
# Inside the window the booking is still cancelled and refunded, minus a
# late-cancellation fee worth one hour of the booked crew (pricePerHour ×
# cleaners), which is kept because the slot can no longer be resold. A booking
# of one hour or less therefore keeps the whole charge. Set to 0 to always
# refund in full.
#CANCELLATION_WINDOW_HOURS=24

# Recurring subscription charging (all optional; defaults shown). The cron is
# hourly so any missed deployment tick self-heals via nextChargeAt <= now.
#SUBSCRIPTION_CRON=15 * * * *
#SUBSCRIPTION_MAX_ATTEMPTS=3
#CHARGE_LEAD_DAYS=1

# Email (Mailtrap sandbox in dev — grab these from your Mailtrap inbox's SMTP settings)
#
# MAIL_HOST, MAIL_USERNAME and MAIL_PASSWORD are REQUIRED — assertEnv aborts
# startup without them. Mail is not a nice-to-have here: no verification email
# means nobody can finish signing up, and no invoice or booking alert ever
# leaves the server. Left optional, that failure was completely silent.
#
# MAIL_FROM stays optional (it falls back to MAIL_USERNAME), but set it in
# production: it must be the authenticated mailbox or one of its aliases, since
# real hosts (IONOS, Gmail, …) reject the whole message with "550 Sender address
# is not allowed" when the envelope sender is an address the account may not
# send as.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM="CasaClean <your-mailtrap-username@example.com>"

# Optional: where website contact-form submissions are announced. Falls back to
# MAIL_FROM (then MAIL_USERNAME). Messages are stored in MongoDB and readable in
# the admin panel either way — leaving this unset only skips the notification,
# it never fails a customer's submission.
#CONTACT_NOTIFY_EMAIL=hello@casaclean.com

# Optional: the business mailbox that is told about every confirmed booking
# (one-off payments and recurring cycles alike). Accepts a comma-separated list.
# Falls back to CONTACT_NOTIFY_EMAIL, then MAIL_FROM, then MAIL_USERNAME.
# Every admin ACCOUNT is notified at its own address regardless of this setting,
# so a working install needs no configuration here — this is for the shared inbox.
#BOOKING_NOTIFY_EMAIL=bookings@casaclean.com

# Google OAuth information
GOOGLE_CLIENT_ID=your-google-id
GOOGLE_CLIENT_SECRET=your-google-secret
GOOGLE_CALLBACK_URL=google-callback-url

# Stripe payments
# STRIPE_SECRET_KEY  — server-side API key (test: sk_test_... / live: sk_live_...)
# STRIPE_WEBHOOK_SECRET — signing secret for /webhooks/stripe (whsec_...).
#   In dev, `stripe listen --forward-to localhost:3000/webhooks/stripe` prints it.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Invoicing (all optional — an invoice is issued and emailed after every
# successful payment whether or not any of this is set; these values only
# control what is PRINTED on it). Each value is snapshotted onto the invoice at
# issue time, so editing them later never restates an already-issued document.
#
# Multi-line values use "|" as the line separator (.env can't carry newlines).
#INVOICE_COMPANY_NAME=CasaClean Services Ltd.
#INVOICE_COMPANY_ADDRESS=Via Roma 42|20121 Milano MI|Italy
#INVOICE_VAT_NUMBER=IT01234567890
#INVOICE_COMPANY_REG_NUMBER=MI-2019-884213
#INVOICE_COMPANY_EMAIL=billing@casaclean.com
#INVOICE_COMPANY_PHONE=+39 02 1234 5678
#INVOICE_COMPANY_WEBSITE=https://casaclean.com

# Prefix of the sequential invoice number: CC-2026-000042.
#INVOICE_NUMBER_PREFIX=CC

# VAT percentage. Catalogue prices are NET, so the rate is added ON TOP of them
# — setting 22 turns a €100.00 catalogue booking into "net €100.00 + VAT €22.00
# = €122.00". Leave unset (or 0) and there is no VAT anywhere: one honest total,
# no VAT line, and no business/individual distinction.
#
# This one variable also switches on the B2B rule. With a rate configured:
#   - an individual pays the catalogue price plus VAT (€122.00);
#   - a business whose VAT number Stripe has VERIFIED against VIES has no VAT
#     added (€100.00), and its invoice carries the EU reverse-charge notice.
# Verification is asynchronous and arrives via the customer.tax_id.* webhooks, so
# add those events to the Stripe endpoint alongside the payment ones. Until a
# number verifies, the customer is charged VAT — fail-closed by design.
#INVOICE_VAT_RATE=22

# Optional TrueType font for the PDF. pdfkit's built-in fonts cannot render
# Greek, Cyrillic or Georgian, so a customer named "გიორგი" would print with
# "?" placeholders. The renderer probes common system font paths (DejaVu, Noto,
# Liberation, Segoe UI, Arial) automatically; set these only to pin a specific
# file — e.g. a Noto Sans that covers every language the site ships.
#INVOICE_FONT_PATH=/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf
#INVOICE_FONT_BOLD_PATH=/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf

SENTRY_DSN=test

# --- Image storage (Cloudinary) ---------------------------------------------
# Where admin-uploaded service cover images are stored.
#
# UNSET => images are written to this server's own disk (server/uploads/) and
# served from /uploads. Fine for local development and for a VPS with real
# storage. NOT fine on Render/Fly/any container host without a mounted volume:
# the filesystem is ephemeral, so every deploy silently deletes every uploaded
# image while the database keeps referencing them.
#
# SET => uploads go to Cloudinary and the document stores the absolute https URL.
# Existing /uploads/... records keep working and stay deletable either way.
#
# Either provide the single URL from your Cloudinary dashboard...
CLOUDINARY_URL=
# ...or the three parts separately (useful when a secret manager mangles URLs).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level folder, so one account can host several environments without them
# deleting each other's assets. Defaults to "casaclean".
CLOUDINARY_FOLDER=
